---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import Navigation from '../../components/Navigation.tsx';
import Footer from '../../components/Footer.tsx';

const posts = await getCollection('blog', ({ data }) => !data.draft);
posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title="Blog | Isra" description="Blog sobre desarrollo web, Linux, automatización y open source.">
  <Navigation client:load />
  <main id="main-content" class="pt-20 pb-24 px-4">
    <div class="max-w-3xl mx-auto">
      <header class="mb-16 text-center">
        <h1 class="text-4xl md:text-5xl font-bold mb-4">
          <span class="bg-gradient-to-r from-purple-400 via-pink-400 to-amber-400 bg-clip-text text-transparent">
            Blog
          </span>
        </h1>
        <p class="text-gray-400 max-w-xl mx-auto">
          Artículos sobre desarrollo, Linux, automatización y herramientas open-source.
        </p>
      </header>

      <div class="space-y-8">
        {
          posts.length === 0 ? (
            <p class="text-center text-gray-500 py-8">No hay artículos todavía.</p>
          ) : (
            posts.map((post) => (
              <a
                href={`/portafolio-astro/blog/${post.id}`}
                class="block group p-6 rounded-2xl bg-dark-700/50 border border-white/5 hover:border-purple-500/30 transition-all"
              >
                <div class="flex items-center gap-2 text-xs text-gray-500 mb-2">
                  <time datetime={post.data.date.toISOString().slice(0, 10)}>
                    {post.data.date.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}
                  </time>
                  {
                    post.data.tags.length > 0 && (
                      <>
                        <span aria-hidden="true">·</span>
                        <span class="text-purple-400">{post.data.tags[0]}</span>
                      </>
                    )
                  }
                </div>
                <h2 class="text-xl font-semibold text-white group-hover:text-purple-400 transition-colors mb-2">
                  {post.data.title}
                </h2>
                <p class="text-gray-400 text-sm line-clamp-2">{post.data.description}</p>
                {
                  post.data.tags.length > 1 && (
                    <div class="flex flex-wrap gap-2 mt-4">
                      {post.data.tags.slice(1).map((tag) => (
                        <span class="px-2 py-0.5 text-xs rounded-full bg-purple-500/10 text-purple-300 border border-purple-500/20">
                          {tag}
                        </span>
                      ))}
                    </div>
                  )
                }
              </a>
            ))
          )
        }
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
